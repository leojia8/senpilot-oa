# --- Gemini (request parsing) ---
# GEMINI_MODE controls whether the API is actually called:
#   mock  = never call Gemini; use the deterministic regex/keyword parser only.
#           Costs nothing and passes every parser test. Safe default.
#   live  = call Gemini, falling back to regex if the call fails.
#   auto  = live when GEMINI_API_KEY is set, otherwise mock.
# The free tier is limited (~20 requests/day), so keep this on "mock" for
# development and flip to "live" for the demo.
GEMINI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Gmail OAuth ---
# Both files are gitignored. credentials.json is the desktop OAuth client secret
# from Google Cloud Console; token.json is written on first authorisation.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# --- Agent behaviour ---
POLL_INTERVAL_SECONDS=60
MAX_DOCUMENTS=10
# true for unattended running; false shows the browser (useful for the demo)
HEADLESS=true
